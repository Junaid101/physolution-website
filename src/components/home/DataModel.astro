---
import type { DataModelContent } from '../../lib/content';

const { data } = Astro.props as { data: DataModelContent };
---

<section id="datamodel" class="px-6 md:px-16 py-28 border-b border-black/10">
  <div class="container-site">
    <div class="flex flex-col md:flex-row justify-between items-start gap-12 mb-16">
      <div class="max-w-2xl">
        <span class="section-eyebrow mb-4">{data.kicker}</span>
        <h2 class="section-title">
          {data.title.map((x) => (
            <>
              <span>{x}</span>
              <br />
            </>
          ))}
        </h2>
      </div>
      <p class="text-black/70 text-sm max-w-sm leading-relaxed">{data.intro}</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      {data.cards.map((card) => (
        <div class="bg-white/80 p-8 rounded-2xl border border-black/10 shadow-sm">
          <span class="text-xs font-mono text-primary block mb-8">{card.step}</span>
          <h3 class="text-xl font-medium mb-3">{card.title}</h3>
          <p class="text-black/65 text-sm leading-relaxed">{card.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
