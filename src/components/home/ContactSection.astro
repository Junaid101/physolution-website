---
import { getLocalizedPath } from '../../lib/languages';
import type { ContactContent } from '../../lib/content';
import type { Language } from '../../lib/languages';

const { data, locale } = Astro.props as { data: ContactContent; locale: Language };
---

<section id="contact" class="px-6 md:px-16 py-32 editorial-grid">
  <div class="max-w-5xl mx-auto text-center">
    <span class="section-eyebrow mb-5">{data.kicker}</span>
    <h2 class="text-4xl sm:text-7xl font-bold tracking-tight leading-[.95] mb-8">
      {data.title.map((x) => (
        <>
          <span>{x}</span>
          <br />
        </>
      ))}
    </h2>
    <p class="text-black/70 max-w-xl mx-auto mb-12 text-base sm:text-lg leading-relaxed">
      {data.intro}
    </p>
    <a href={getLocalizedPath(locale, '/contact/')} class="button-primary shadow-xl">
      {data.cta}
    </a>
  </div>
</section>
