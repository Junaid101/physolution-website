---
import {
  getLocalizedPath,
  getSupportedLanguage,
  LANGUAGE_LABELS,
  SUPPORTED_LANGUAGES,
} from '../lib/languages';

const { data } = Astro.props;
const currentLanguage = getSupportedLanguage(Astro.url.pathname.split('/')[1]);
const home = getLocalizedPath(currentLanguage, '/');
const contact = getLocalizedPath(currentLanguage, '/contact/');
const contactSection = home + '#contact';
---

<header class="w-full max-w-[1600px] mx-auto px-6 md:px-16 py-8 flex justify-between items-center relative z-50">
  <a href={home} class="font-semibold text-lg tracking-tight">
    PhySolution
  </a>

  <nav class="hidden md:flex items-center gap-8 text-xs uppercase tracking-widest font-medium">
    <a href={home + '#services'} class="hover:text-[#002bff]">{data.nav[0]}</a>
    <a href={home + '#about'} class="hover:text-[#002bff]">{data.nav[1]}</a>
    <a href={home + '#technology'} class="hover:text-[#002bff]">{data.footer.technologyLabel}</a>
    <a href={contact} class="hover:text-[#002bff]">{data.contactPage.title}</a>
  </nav>

  <div class="flex items-center gap-6 text-xs uppercase tracking-widest font-medium">
    <div class="flex items-center border border-black/20 rounded-sm p-1" aria-label="Language switcher">
      {SUPPORTED_LANGUAGES.map((language) => (
        language === currentLanguage ? (
          <span class="px-2 py-1 bg-black text-white rounded-sm" aria-current="page">
            {LANGUAGE_LABELS[language]}
          </span>
        ) : (
          <a
            href={getLocalizedPath(language, Astro.url.pathname)}
            hreflang={language}
            class="px-2 py-1 hover:bg-black/5 rounded-sm transition-colors"
          >
            {LANGUAGE_LABELS[language]}
          </a>
        )
      ))}
    </div>

    <a
      href={contactSection}
      class="hidden md:inline-flex items-center justify-center border border-[#002bff] text-[#002bff] px-5 py-2.5 rounded-full hover:bg-[#002bff] hover:text-white transition-colors"
    >
      {data.contactLabel}
    </a>
  </div>
</header>
  <a
    href={contactSection}
    class="md:hidden fixed bottom-5 right-5 z-[60] inline-flex items-center justify-center bg-[#002bff] text-white px-5 py-3 rounded-full text-xs uppercase tracking-widest font-medium shadow-lg"
  >
    {data.contactLabel}
  </a>

