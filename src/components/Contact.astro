---
import Header from './Header.astro';
import Footer from './Footer.astro';

const { data } = Astro.props;
const mapsUrl =
  'https://www.google.com/maps/search/?api=1&query=Ringstr.+11%2C+76356+Weingarten+%28Baden%29';
---

<main class="min-h-screen relative bg-[#f3f2ee] text-[#111]">
  <Header data={data} />

  <section class="px-6 md:px-16 pt-16 pb-28 md:pt-24 md:pb-36">
    <div class="max-w-7xl mx-auto">
      <span class="text-xs font-mono uppercase tracking-widest text-[#002bff] block mb-6">
        {data.contactPage.kicker}
      </span>
      <div class="grid grid-cols-1 lg:grid-cols-[1.2fr_.8fr] gap-16 lg:gap-24">
        <div>
          <h1 class="text-5xl sm:text-7xl md:text-8xl font-black tracking-tighter leading-[.9]">
            {data.contactPage.title}
          </h1>
          <p class="max-w-2xl mt-10 text-base md:text-lg leading-relaxed text-black/65">
            {data.contactPage.lead}
          </p>
        </div>

        <div class="border-t border-black/20 pt-6">
          <p class="text-xs font-mono uppercase tracking-widest text-black/40 mb-8">
            {data.contactPage.company}
          </p>

          <div class="space-y-8 text-lg">
            <address class="not-italic leading-relaxed">
              {data.contactPage.address.map((line: string) => (
                <span class="block">{line}</span>
              ))}
            </address>

            <div class="space-y-3">
              <a
                href={`tel:${data.contactPage.phone.replace(/[^+\d]/g, '')}`}
                class="block hover:text-[#002bff] transition-colors"
              >
                {data.contactPage.phone}
              </a>
              <a
                href={`mailto:${data.contactPage.email}`}
                class="block hover:text-[#002bff] transition-colors"
              >
                {data.contactPage.email}
              </a>
              <a
                href={mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex mt-3 text-sm font-mono uppercase tracking-widest text-[#002bff] hover:text-black transition-colors"
              >
                {data.contactPage.directionsLabel} ↗
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer data={data} />
</main>
