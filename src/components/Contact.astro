---
import Header from './Header.astro';
import Footer from './Footer.astro';
import type { Language } from '../lib/languages';

const { data, locale } = Astro.props as { data: import('../lib/content').SiteContent; locale: Language };
const mapsUrl =
  'https://www.google.com/maps/search/?api=1&query=Ringstr.+11%2C+76356+Weingarten+%28Baden%29';
---

<main class="min-h-screen relative bg-[#f3f2ee] text-[#111]">
  <Header data={data} locale={locale} />

  <section class="section-padding pt-16 pb-28 md:pt-24 md:pb-36">
    <div class="container-site">
      <span class="section-eyebrow text-primary mb-6">
        {data.contactPage.kicker}
      </span>
      <div class="grid grid-cols-1 lg:grid-cols-[1.2fr_.8fr] gap-16 lg:gap-24">
        <div>
          <h1 class="page-title">
            {data.contactPage.title}
          </h1>
          <p class="max-w-2xl mt-10 body-copy">
            {data.contactPage.lead}
          </p>
        </div>

        <div class="border-t border-black/20 pt-6">
          <p class="text-xs font-mono uppercase tracking-widest text-black/40 mb-8">
            {data.contactPage.company}
          </p>

          <div class="space-y-8 text-lg">
            <address class="not-italic leading-relaxed">
              {data.contactPage.address.map((line) => (
                <span class="block">{line}</span>
              ))}
            </address>

            <div class="space-y-3">
              <a
                href={`tel:${data.contactPage.phone.replace(/[^+\d]/g, '')}`}
                class="block link-primary"
              >
                {data.contactPage.phone}
              </a>
              <a
                href={`mailto:${data.contactPage.email}`}
                class="block link-primary"
              >
                {data.contactPage.email}
              </a>
              <a
                href={mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex mt-3 text-sm font-mono uppercase tracking-widest text-primary hover:text-black transition-colors"
              >
                {data.contactPage.directionsLabel} ↗
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer data={data} locale={locale} />
</main>
