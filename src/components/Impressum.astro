---
import Header from './Header.astro';
import Footer from './Footer.astro';
const { data } = Astro.props;
---
<main class="min-h-screen relative">
  <Header data={data} />
  <section class="px-6 md:px-16 py-20 md:py-32 border-t border-black/10">
    <div class="max-w-7xl mx-auto">
      <div class="max-w-4xl">
        <span class="text-xs font-mono uppercase tracking-widest text-[#002bff] block mb-6">{data.impressum.kicker}</span>
        <h1 class="text-5xl md:text-8xl font-black tracking-tighter leading-[.9] mb-16">{data.impressum.title}</h1>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-black/15 border border-black/15">
        <div class="bg-[#f3f2ee] p-8 md:p-10 md:col-span-2">
          <span class="text-[10px] font-mono uppercase tracking-widest text-black/40 block mb-5">{data.lang === 'de' ? 'Unternehmen' : 'Company'}</span>
          <h2 class="text-2xl md:text-3xl font-semibold leading-tight mb-8">{data.impressum.company}</h2>
          <address class="not-italic text-black/70 leading-relaxed">{data.impressum.address.map((line:string)=><span class="block">{line}</span>)}</address>
        </div>
        <div class="bg-[#f3f2ee] p-8 md:p-10">
          <span class="text-[10px] font-mono uppercase tracking-widest text-black/40 block mb-5">{data.lang === 'de' ? 'Kontakt' : 'Contact'}</span>
          <div class="space-y-2 text-sm"><a href={`mailto:${data.impressum.email}`} class="block hover:text-[#002bff]">{data.impressum.email}</a><a href={`tel:${data.impressum.phone.replace(/[^+\d]/g,'')}`} class="block hover:text-[#002bff]">{data.impressum.phone}</a></div>
        </div>
        <div class="bg-[#f3f2ee] p-8 md:p-10 md:col-span-3 border-t border-black/15">
          <span class="text-[10px] font-mono uppercase tracking-widest text-black/40 block mb-5">{data.lang === 'de' ? 'Registerangaben' : 'Registration'}</span>
          <p class="text-sm text-black/70">{data.impressum.register}</p>
        </div>
      </div>
      <div class="mt-12 max-w-3xl border-l-2 border-[#002bff] pl-6 text-sm text-black/55 leading-relaxed"><p>{data.impressum.notice}</p></div>
    </div>
  </section>
  <Footer data={data}/>
</main>