---
import Header from './Header.astro';
import Footer from './Footer.astro';
import { getLocalizedPath } from '../lib/languages';
import type { Language } from '../lib/languages';

const { data, locale } = Astro.props as { data: import('../lib/content').SiteContent; locale: Language };
const currentLanguage = locale;
const home = getLocalizedPath(currentLanguage, '/');
const sections = data.impressum.sections;
---

<main class="min-h-screen relative bg-[#f3f2ee]">
  <Header data={data} locale={locale} />
  <section class="section-padding pt-16 md:pt-24 pb-24 md:pb-32 border-t border-black/10">
    <div class="container-site">
      <header class="max-w-4xl pb-16 md:pb-24 border-b border-black/10">
        <span class="section-eyebrow text-primary mb-6 tracking-[.18em]">
          {data.impressum.kicker}
        </span>
        <h1 class="page-title mb-8">
          {data.impressum.title}
        </h1>
        <p class="max-w-2xl body-copy text-black/60">
          {data.impressum.lead}
        </p>
      </header>
      <div class="max-w-4xl">
        {sections.map((section, index) => (
          <article class="py-10 md:py-12 border-b border-black/10 grid grid-cols-1 md:grid-cols-[220px_1fr] gap-6 md:gap-12">
            <div>
              <span class="text-[10px] font-mono uppercase tracking-[.16em] text-black/40">
                0{index + 1}
              </span>
              <h2 class="mt-2 text-base md:text-lg font-semibold tracking-tight">{section.title}</h2>
            </div>
            <div class="text-sm md:text-[15px] leading-7 text-black/65 space-y-2">
              {section.blocks.map((block) => (
                block.type === 'link' ? (
                  <div>
                    <span class="font-semibold text-black">{block.label}:</span>{' '}
                    <a
                      href={block.href}
                      class="text-black underline underline-offset-4 hover:text-primary"
                    >
                      {block.value}
                    </a>
                  </div>
                ) : block.type === 'field' ? (
                  <div>
                    <span class="font-semibold text-black">{block.label}:</span>{' '}
                    <span>{block.value}</span>
                  </div>
                ) : (
                  <p>{block.value}</p>
                )
              ))}
            </div>
          </article>
        ))}
      </div>
      <div class="mt-10 max-w-4xl flex flex-col sm:flex-row justify-between gap-4 text-[10px] font-mono uppercase tracking-widest text-black/35">
        <span>{data.statusLabel}</span>
        <a href={home} class="link-primary">
          {data.websiteLabel}
        </a>
      </div>
    </div>
  </section>
  <Footer data={data} locale={locale} />
</main>
