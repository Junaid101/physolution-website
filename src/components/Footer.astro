---
const { data } = Astro.props;
---

<footer class="border-t border-black bg-[#111] text-[#f3f2ee]">
  <div class="max-w-7xl mx-auto px-6 md:px-16 py-16 md:py-20">
    <div class="flex flex-col lg:flex-row justify-between gap-16">
      <div class="max-w-xl">
        <span class="text-xs font-mono uppercase tracking-widest text-white/45 block mb-6">07 / {data.lang === 'de' ? 'Unternehmen' : 'Company'}</span>
        <div class="text-4xl md:text-6xl font-black tracking-tighter leading-[.9] uppercase">
          {data.footer.company}
        </div>
        <p class="mt-8 max-w-md text-sm leading-relaxed text-white/55">
          {data.lang === 'de'
            ? 'Technische Beratung und Projektmanagement für verlässliche Stammdaten, klare Prozesse und belastbare Datenstrukturen.'
            : 'Technical consulting and project management for reliable master data, clear processes and robust data structures.'}
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-12 lg:gap-20 text-sm">
        <div>
          <span class="text-[10px] font-mono uppercase tracking-widest text-white/40 block mb-5">{data.footer.contactLabel}</span>
          <div class="space-y-2 text-white/75">
            <a href={`mailto:${data.footer.email}`} class="block hover:text-white transition-colors">{data.footer.email}</a>
            <a href={`tel:${data.footer.phone.replace(/[^+\d]/g,'')}`} class="block hover:text-white transition-colors">{data.footer.phone}</a>
          </div>
        </div>
        <div>
          <span class="text-[10px] font-mono uppercase tracking-widest text-white/40 block mb-5">{data.lang === 'de' ? 'Sitz' : 'Office'}</span>
          <address class="not-italic text-white/75 leading-relaxed">
            {data.footer.address.map((line:string)=><span class="block">{line}</span>)}
          </address>
        </div>
      </div>
    </div>

    <div class="mt-16 pt-5 border-t border-white/15 flex flex-col md:flex-row justify-between gap-5 text-[10px] font-mono uppercase tracking-widest text-white/40">
      <div class="flex flex-wrap gap-x-6 gap-y-2">
        {data.footer.legal.map((item:string[])=><a href={item[1]} class="hover:text-white transition-colors">{item[0]}</a>)}
        <a href="https://www.physolution.com/" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">{data.original}</a>
      </div>
      <div class="flex flex-wrap gap-x-6 gap-y-2">
        <span>{data.footer.company} © 2026</span>
        <a href="#heroSection" class="hover:text-white transition-colors">{data.top}</a>
      </div>
    </div>
  </div>
</footer>