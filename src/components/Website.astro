---
import Header from './Header.astro';
import Footer from './Footer.astro';
const { data } = Astro.props;
---

<main id="mainWebsite" class="min-h-screen relative">
  <Header data={data} />

  <section
    id="heroSection"
    class="relative min-h-[90vh] px-6 md:px-16 pt-12 pb-20 flex flex-col justify-between editorial-grid border-b border-black/10 overflow-hidden"
  >
    <div id="heroBlueBar" class="blue-bar"></div>
    <div id="heroBlackContent" class="content-layer">
      <div class="container-site w-full">
        <span class="section-eyebrow text-primary mb-6">
          {data.hero.kicker}
        </span>
        <h1 class="text-black text-5xl sm:text-7xl lg:text-8xl font-black tracking-tighter leading-[.92] mb-10 max-w-7xl">
          {data.hero.title.map((x: string) => (
            <>
              <>
                <span>{x}</span>
                <br />
              </>
            </>
          ))}
        </h1>
        <p class="max-w-2xl body-copy sm:text-lg">
          {data.hero.intro}
        </p>
      </div>
      <div class="container-site w-full flex flex-col sm:flex-row justify-between items-start sm:items-end gap-6 mt-16">
        <div class="flex items-center gap-2 text-xs font-mono tracking-widest text-black/60">
          <span class="w-2 h-2 bg-primary"></span>
          {data.hero.since}
        </div>
        <a
          href="#services"
          class="text-sm uppercase tracking-widest font-medium hover:text-primary"
        >
          {data.hero.cta}
        </a>
      </div>
    </div>
    <div id="heroWhiteContent" class="white-layer"></div>
  </section>

  <section
    id="services"
    class="relative px-6 md:px-16 py-32 overflow-hidden editorial-grid border-b border-black/10"
    style="min-height:100vh"
  >
    <div id="scrollBluePanel" class="blue-bar"></div>
    <div id="workBlackContent" class="content-layer">
      <div class="container-site">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-16 gap-8">
          <div>
            <span class="section-eyebrow mb-3">
              {data.services.kicker}
            </span>
            <h2 class="section-title">
              {data.services.title.map((x: string) => (
                <>
                  <>
                    <span>{x}</span>
                    <br />
                  </>
                </>
              ))}
            </h2>
          </div>
          <p class="text-black/70 text-sm max-w-sm leading-relaxed">{data.services.intro}</p>
        </div>
        <div class="divide-y divide-black/20 border-t border-b border-black/20">
          {data.services.items.map((item) => (
            <div class="py-7 px-4 flex flex-col sm:flex-row justify-between sm:items-center gap-4">
              <>
                <span class="text-2xl md:text-4xl font-bold tracking-tight">{item.title}</span>
                <div class="flex items-center gap-6">
                  <>
                    <span class="text-xs font-mono uppercase opacity-70 hidden sm:block">
                      {item.description}
                    </span>
                    <span class="text-xl">↗</span>
                  </>
                </div>
              </>
            </div>
          ))}
        </div>
      </div>
    </div>
    <div id="workWhiteContent" class="white-layer"></div>
  </section>

  <section id="about" class="px-6 md:px-16 py-28 editorial-grid border-b border-black/10">
    <div class="container-site flex flex-col lg:flex-row justify-between items-start gap-16">
      <div class="max-w-3xl">
        <span class="section-eyebrow mb-4">
          {data.about.kicker}
        </span>
        <h2 class="section-title leading-none mb-10">
          {data.about.title.map((x: string) => (
            <>
              <>
                <span>{x}</span>
                <br />
              </>
            </>
          ))}
        </h2>
        <div class="body-copy space-y-6">
          {data.about.paragraphs.map((p: string) => (
            <p>{p}</p>
          ))}
        </div>
      </div>
      <div class="w-full lg:w-80">
        <div class="border-t border-black/20 pt-6 mb-10">
          <span class="section-eyebrow text-black/40">
            {data.about.historyLabel}
          </span>
        </div>
        <div class="space-y-8">
          {data.about.history.map((x) => (
            <div>
              <>
                <span class="text-primary font-mono text-sm font-bold">{x.year}</span>
                <p class="text-sm text-black/65 mt-2">{x.title}</p>
              </>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="datamodel" class="px-6 md:px-16 py-28 border-b border-black/10">
    <div class="container-site">
      <div class="flex flex-col md:flex-row justify-between items-start gap-12 mb-16">
        <div class="max-w-2xl">
          <span class="section-eyebrow mb-4">
            {data.model.kicker}
          </span>
          <h2 class="section-title">
            {data.model.title.map((x: string) => (
              <>
                <>
                  <span>{x}</span>
                  <br />
                </>
              </>
            ))}
          </h2>
        </div>
        <p class="text-black/70 text-sm max-w-sm leading-relaxed">{data.model.intro}</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        