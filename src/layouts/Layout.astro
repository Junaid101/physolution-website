---
import '../styles/global.css';
import { getSupportedLanguage } from '../lib/languages';
const {title,description}=Astro.props;
const locale = getSupportedLanguage(Astro.url.pathname.split('/')[1]);
---
<!doctype html>
<html lang={locale}>
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="description" content={description}><title>{title}</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
</head><body><slot /></body></html>